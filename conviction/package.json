{
  "name": "wavefund",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:contracts && next build",
    "start": "next start",
    "check:contracts": "node contracts/script/check-contracts.mjs",
    "e2e:live": "node scripts/e2e-live.mjs",
    "pool:recenter": "node --env-file=.env contracts/script/pool-recenter.mjs",
    "demo:round": "node --env-file=.env contracts/script/demo-round.mjs",
    "demo:open-round": "node --env-file=.env contracts/script/demo-open-round.mjs",
    "demo:close-round": "node --env-file=.env contracts/script/demo-close-round.mjs",
    "keeper:run": "node --env-file=.env contracts/script/keeper-run.mjs",
    "oracle:update": "node --env-file=.env contracts/script/update-oracle.mjs",
    "oracle:start": "node --env-file=.env contracts/script/update-oracle.mjs start",
    "oracle:stop": "node --env-file=.env contracts/script/update-oracle.mjs stop"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@uniswap/permit2-sdk": "^1.4.1",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "next": "15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "postcss": "^8.5.31"
  }
}
